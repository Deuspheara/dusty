{
  "name": "dusty-cli",
  "version": "0.1.0",
  "description": "Dusty CLI: reclaim disk space on macOS (build artifacts, dev caches, Xcode, Android, Docker).",
  "type": "module",
  "bin": {
    "dusty": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "dev": "tsup src/index.ts --format esm --target node20 --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deuspheara/dusty"
  }
}
